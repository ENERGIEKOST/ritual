<a class="fab-item wa" href="https://wa.me/79515353534" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i><span class="tip">WhatsApp</span></a>
<a class="fab-item max" href="https://max.ru" target="_blank" rel="noopener" aria-label="Max"><i class="fa-solid fa-paper-plane"></i><span class="tip">Max</span></a>
</div>
<button class="fab-main" id="fabMain" aria-label="Открыть способы связи"><i class="fa-solid fa-comment-dots" id="fabIcon"></i></button>
</div>

<div class="copy-toast" id="copyToast">Текст заявки скопирован! Вставьте его в чат MAX.</div>

<script>
(function(){
'use strict';
/* ── ПРОГРЕСС ПРОКРУТКИ ── */
var bar=document.getElementById('progress');
function onScroll(){var h=document.documentElement,p=h.scrollTop/(h.scrollHeight-h.clientHeight||1);if(bar)bar.style.width=(p*100).toFixed(2)+'%';}
window.addEventListener('scroll',onScroll,{passive:true});onScroll();

/* ── МОБИЛЬНОЕ МЕНЮ ── */
var burger=document.getElementById('burger'),mMenu=document.getElementById('mMenu'),mOverlay=document.getElementById('mOverlay'),mClose=document.getElementById('mClose');
function menuShow(v){if(!mMenu||!mOverlay)return;mMenu.classList.toggle('open',v);mOverlay.classList.toggle('open',v);document.body.style.overflow=v?'hidden':'';}
if(burger)burger.addEventListener('click',function(){menuShow(true)});
if(mClose)mClose.addEventListener('click',function(){menuShow(false)});
if(mOverlay)mOverlay.addEventListener('click',function(){menuShow(false)});
mMenu&&mMenu.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){menuShow(false)})});

/* ── ПЛАВАЮЩИЙ ВИДЖЕТ МЕССЕНДЖЕРОВ ── */
var fabBox=document.getElementById('fab'),fabMain=document.getElementById('fabMain'),fabItems=document.getElementById('fabItems'),fabIcon=document.getElementById('fabIcon'),fabOpen=false;
function fabToggle(v){fabOpen=v;fabBox&&fabBox.classList.toggle('open',v);if(fabIcon)fabIcon.className=v?'fa-solid fa-xmark':'fa-solid fa-comment-dots';}
if(fabMain){fabMain.addEventListener('click',function(e){e.stopPropagation();fabToggle(!fabOpen);});}
document.addEventListener('click',function(e){if(fabOpen&&fabBox&&!fabBox.contains(e.target))fabToggle(false);});

/* ── КУКИ ── */
var cb=document.getElementById('cookieBanner');
function ckHide(){cb&&cb.classList.remove('show');}
try{if(!localStorage.getItem('rpCookie'))setTimeout(function(){cb&&cb.classList.add('show')},900);}catch(e){}
var ckAll=document.getElementById('ckAll'),ckMin=document.getElementById('ckMin');
if(ckAll)ckAll.addEventListener('click',function(){try{localStorage.setItem('rpCookie','all')}catch(e){}ckHide();});
if(ckMin)ckMin.addEventListener('click',function(){try{localStorage.setItem('rpCookie','min')}catch(e){}ckHide();});

/* ── МОДАЛКИ ── */
var openModal=null;
document.addEventListener('click',function(e){
 var opener=e.target.closest('[data-modal]');
 if(opener){e.preventDefault();var m=document.getElementById(opener.getAttribute('data-modal')+'Modal');if(m){m.classList.add('open');openModal=m;document.body.style.overflow='hidden';}return;}
 var closer=e.target.closest('[data-close]');
 if(closer&&openModal){openModal.classList.remove('open');openModal=null;document.body.style.overflow='';return;}
 if(openModal&&e.target===openModal){openModal.classList.remove('open');openModal=null;document.body.style.overflow='';}
});
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&openModal){openModal.classList.remove('open');openModal=null;document.body.style.overflow='';}});

/* ── АКТИВНЫЙ ПУНКТ МЕНЮ ── */
var secs=['works','catalog','guarantees','process','reviews','faq','contacts'].map(function(id){return document.getElementById(id)}).filter(Boolean);
var navLinks=document.querySelectorAll('a[href^="#"]');
function setActive(){var y=window.scrollY+120,cur=null;secs.forEach(function(s){if(s.offsetTop<=y)cur=s.id;});
navLinks.forEach(function(a){a.classList.toggle('active',cur&&a.getAttribute('href')==='#'+cur&&a.closest('nav, .mobile-menu'));});}
window.addEventListener('scroll',setActive,{passive:true});setActive();

/* ── КВИЗ ── */
var step=1,TOTAL=6,answers={},mess=null;
var steps=document.querySelectorAll('.quiz-step');
var qStep=document.getElementById('qStep'),qPct=document.getElementById('qPct'),qBar=document.getElementById('qBar');
var qBack=document.getElementById('qBack'),qNext=document.getElementById('qNext'),qSubmit=document.getElementById('qSubmit'),qSubmitTxt=document.getElementById('qSubmitTxt');
function show(n){steps.forEach(function(s){s.classList.toggle('active',+s.dataset.step===n)});
 if(qStep)qStep.textContent='Шаг '+n+' из '+TOTAL;
 var pct=Math.round(n/TOTAL*100);if(qPct)qPct.textContent=pct+'%';if(qBar)qBar.style.width=pct+'%';
 if(qBack)qBack.style.visibility=n===1?'hidden':'visible';
 if(qNext)qNext.style.display=n<TOTAL?'':'none';
 if(qSubmit)qSubmit.style.display=n===TOTAL?'':'none';
 if(n===TOTAL)bindMask();}
function err(id,on){var el=document.getElementById(id);if(el)el.style.display=on?'block':'none';}
['err1','err2','err3','err4','err5','errName','errPhone','errMess','errConsent'].forEach(function(id){var el=document.getElementById(id);if(el)el.style.display='none';});

/* выбор вариантов: шаг 4 — мультивыбор */
document.querySelectorAll('.quiz-step').forEach(function(st){
 var sn=+st.dataset.step;
 st.querySelectorAll('.q-opt').forEach(function(opt){
 opt.addEventListener('click',function(){
 if(sn===4){opt.classList.toggle('sel');
 var any=st.querySelectorAll('.q-opt.sel').length>0;
 err('err4',!any);return;}
 st.querySelectorAll('.q-opt').forEach(function(o){o.classList.remove('sel')});
 opt.classList.add('sel');err('err'+sn,false);
 answers['q'+sn]=opt.dataset.val||opt.textContent.trim();
 setTimeout(next,280);
 });});});

/* выбор мессенджера */
document.querySelectorAll('.mess-choice .q-opt').forEach(function(opt){
 opt.addEventListener('click',function(){
 document.querySelectorAll('.mess-choice .q-opt').forEach(function(o){o.classList.remove('sel')});
 opt.classList.add('sel');mess=opt.dataset.mess;
 if(qSubmitTxt)qSubmitTxt.textContent=mess==='max'?'Отправить в Max':'Отправить в WhatsApp';
 err('errMess',false);});});

function validate(cur){
 if(cur<6)return false;
 var ok=true;
 var name=(document.getElementById('qName')||{}).value||'';
 var raw=(document.getElementById('qPhone')||{}).value||'';
 if(name.trim().length<2){err('errName',true);ok=false}else err('errName',false);
 if(!phoneOk(raw)){err('errPhone',true);ok=false}else err('errPhone',false);
 if(!mess){err('errMess',true);ok=false}else err('errMess',false);
 var c=document.getElementById('qConsent');
 if(!c||!c.checked){err('errConsent',true);ok=false}else err('errConsent',false);
 return ok;}

function next(){
 var st=document.querySelector('.quiz-step[data-step="'+step+'"]');if(!st)return;
 if(step<6){var chosen=st.querySelectorAll('.q-opt.sel').length>0;
 if(!chosen){err('err'+step,true);return;}
 step++;show(step);var card=document.querySelector('.quiz-card');card&&card.scrollIntoView({behavior:'smooth',block:'nearest'});}
 else{if(validate(6))submit();}}

if(qNext)qNext.addEventListener('click',next);
if(qBack)qBack.addEventListener('click',function(){if(step>1){step--;show(step);}var e=document.getElementById('err'+step);e&&(e.style.display='none');});
if(qSubmit)qSubmit.addEventListener('click',function(){if(validate(6))submit();});

/* ── МАСКА ТЕЛЕФОНА ── */
var ALLOWED={3:1,4:1,6:1,8:1,9:1};
function maskPhone(raw){
 var d=(raw||'').replace(/\D/g,'');
 if(d.length&&d[0]==='8')d='7'+d.slice(1);
 if(d.length&&d[0]!=='7')d='7'+d;
 d=d.slice(0,11);
 if(!d)return'';
 var r='+7';
 if(d.length>1)r+=' ('+d.slice(1,4);
 if(d.length>=5)r+=') '+d.slice(4,7);
 if(d.length>=8)r+='-'+d.slice(7,9);
 if(d.length>=10)r+='-'+d.slice(9,11);
 return r;}
function phoneOk(raw){var d=(raw||'').replace(/\D/g,'');if(d[0]==='8')d='7'+d.slice(1);if(d.length!==11||d[0]!=='7')return false;return!!ALLOWED[d[1]];}
var maskBound=false;
function bindMask(){var p=document.getElementById('qPhone');if(!p||maskBound)return;maskBound=true;
 p.addEventListener('input',function(){p.value=maskPhone(p.value);});}

/* ── СБОРКА ЗАЯВКИ ── */
/* 
  ВАЖНО: замените MAX_URL на вашу персональную ссылку из профиля MAX.
  Как получить: откройте MAX → профиль → «Пригласить по ссылке» → скопируйте.
*/
var MAX_URL='https://max.ru/u/ВАШ_ХЕШ'; /* <-- ЗАМЕНИТЕ НА ВАШУ ССЫЛКУ */
function buildText(){
 var L=[];
 L.push('Здравствуйте, Артём! Заявка с сайта «Ритуал-Память».');
 L.push('Имя: '+(document.getElementById('qName').value.trim()));
 L.push('Телефон: '+(document.getElementById('qPhone').value.trim()));
 var lbl={1:'Для кого: ',2:'Бюджет: ',3:'Форма: ',5:'Сроки: '};
 for(var i=1;i<=5;i++){if(answers['q'+i]){L.push(lbl[i]+answers['q'+i]);}}
 var st4=document.querySelector('.quiz-step[data-step="4"]');
 if(st4){var sel=[].slice.call(st4.querySelectorAll('.q-opt.sel')).map(function(o){return o.textContent.trim()});
 if(sel.length)L.push('Оформление: '+sel.join(', '));}
 return L.join('\n');}
function submit(){
 var t=buildText();
 if(mess==='max'){
   window.open(MAX_URL,'_blank','noopener');
   var showToast=function(){
     var toast=document.getElementById('copyToast');
     if(toast){toast.classList.add('show');setTimeout(function(){toast.classList.remove('show')},3500);}
   };
   if(navigator.clipboard&&navigator.clipboard.writeText){
     navigator.clipboard.writeText(t).then(showToast,showToast);
   }else{
     var ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();
     try{document.execCommand('copy')}catch(e){}
     document.body.removeChild(ta);
     showToast();
   }
 }else{
   window.open('https://wa.me/79515353534?text='+encodeURIComponent(t),'_blank','noopener');
 }
 /* сброс квиза */
 show(1);step=1;answers={};mess=null;
 document.querySelectorAll('.quiz-step .q-opt.sel').forEach(function(o){o.classList.remove('sel')});
 document.querySelectorAll('.mess-choice .q-opt.sel').forEach(function(o){o.classList.remove('sel')});
 var nameInp=document.getElementById('qName');if(nameInp)nameInp.value='';
 var phoneInp=document.getElementById('qPhone');if(phoneInp)phoneInp.value='';
 var cons=document.getElementById('qConsent');if(cons)cons.checked=false;
 if(qSubmitTxt)qSubmitTxt.textContent='Отправить в WhatsApp';
}
show(1);
})();
</script>
</body>
</html>
