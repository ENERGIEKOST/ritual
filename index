<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ритуал-Память — изготовление памятников в Батайске под ключ</title>
<meta name="description" content="Изготовление и установка памятников в Батайске. Собственный карьер в Карелии, 1200+ образцов гранита и мрамора. Гарантия 30 лет. Рейтинг 5,0 на Яндекс Картах.">
<!-- Open Graph -->
<meta property="og:type" content="website">
<meta property="og:title" content="Ритуал-Память — памятники в Батайске от карьера в Карелии">
<meta property="og:description" content="Собственный карьер в Карелии, 1200+ образцов гранита и мрамора. Гарантия 30 лет, установка по РФ.">
<meta property="og:image" content="https://ritual-pamjat.clients.site/og-cover.jpg">
<meta property="og:url" content="https://ritual-pamjat.clients.site/">
<meta name="twitter:card" content="summary_large_image">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
:root{
  --bg:#14161a;--bg2:#1b1e24;--card:#232730;--card2:#2a2f3a;
  --gold:#d4a94e;--gold2:#e8c47a;--text:#e8e6e1;--muted:#a7a9ad;
  --green:#25d366;--maxc:#8778ff;
  --ff:'Georgia',serif;--fs:'Segoe UI',system-ui,Arial,sans-serif;
  --radius:16px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--fs);line-height:1.6;overflow-x:hidden}
.container{max-width:1240px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--ff);font-weight:600}
.section{padding:84px 0}
.section.alt{background:var(--bg2)}
.section-title{text-align:center;font-size:clamp(28px,4vw,42px);margin-bottom:14px;color:#fff}
.section-sub{text-align:center;color:var(--muted);max-width:660px;margin:0 auto 48px;font-size:17px}
.gold{color:var(--gold)}
#progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--gold),var(--gold2));z-index:1001;transition:width .1s linear}

/* Кнопки */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 26px;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;border:none;text-decoration:none;transition:transform .2s,box-shadow .2s;white-space:nowrap}
.btn:active{transform:scale(.97)}
.btn-gold{background:linear-gradient(135deg,var(--gold),#b8860b);color:#1a1a1a}
.btn-gold:hover{box-shadow:0 6px 24px rgba(212,169,78,.4);transform:translateY(-2px)}
.btn-green{background:var(--green);color:#fff}
.btn-green:hover{box-shadow:0 6px 24px rgba(37,211,102,.35);transform:translateY(-2px)}
.btn-outline{background:transparent;color:var(--gold);border:1.5px solid var(--gold)}
.btn-outline:hover{background:rgba(212,169,78,.12)}

/* Шапка */
header{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(20,22,26,.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(212,169,78,.25)}
.nav-wrap{display:flex;align-items:center;justify-content:space-between;height:72px;gap:16px}
.logo{display:flex;align-items:center;gap:10px;font-family:var(--ff);font-size:19px;letter-spacing:1.5px;color:#fff;text-decoration:none;white-space:nowrap}
.logo i{color:var(--gold);font-size:22px}
nav.desktop{display:flex;gap:22px}
nav.desktop a{color:var(--text);text-decoration:none;font-size:15px;position:relative;padding:6px 0;white-space:nowrap}
nav.desktop a::after{content:'';position:absolute;left:0;bottom:0;width:0;height:2px;background:var(--gold);transition:width .3s}
nav.desktop a:hover::after,nav.desktop a.active::after{width:100%}
.nav-actions{display:flex;gap:10px;align-items:center}
.burger{display:none;background:none;border:none;color:var(--gold);font-size:24px;cursor:pointer;padding:8px}

/* Мобильное меню */
.mobile-menu{position:fixed;top:0;right:-300px;width:288px;height:100vh;background:var(--bg2);z-index:1002;padding:80px 26px 28px;transition:right .35s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;gap:6px;box-shadow:-8px 0 40px rgba(0,0,0,.5)}
.mobile-menu.open{right:0}
.mobile-menu a{color:var(--text);text-decoration:none;padding:13px 12px;border-radius:10px;display:flex;align-items:center;gap:14px;opacity:0;transform:translateX(30px);transition:opacity .35s,transform .35s,background .2s}
.mobile-menu.open a{opacity:1;transform:translateX(0)}
.mobile-menu.open a:nth-child(2){transition-delay:.05s}.mobile-menu.open a:nth-child(3){transition-delay:.1s}.mobile-menu.open a:nth-child(4){transition-delay:.15s}.mobile-menu.open a:nth-child(5){transition-delay:.2s}.mobile-menu.open a:nth-child(6){transition-delay:.25s}.mobile-menu.open a:nth-child(7){transition-delay:.3s}.mobile-menu.open a:nth-child(8){transition-delay:.35s}
.mobile-menu a:hover{background:rgba(212,169,78,.1);color:var(--gold)}
.mobile-menu a i{color:var(--gold);width:20px;text-align:center}
.menu-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);opacity:0;pointer-events:none;transition:opacity .3s;z-index:1001}
.menu-overlay.open{opacity:1;pointer-events:auto}
.menu-close{position:absolute;top:18px;right:18px;background:none;border:none;color:var(--muted);font-size:22px;cursor:pointer}

/* HERO */
.hero{
  padding: 110px 0 40px; /* Уменьшили отступы, чтобы влезло на ноутбук */
  position: relative;
  background: url('shop.jpg') no-repeat center center;
  background-size: cover;
  min-height: 100vh; /* Блок занимает ровно один экран */
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(18,20,24,0.96) 0%, rgba(18,20,24,0.82) 100%);
  z-index: 0;
}
.hero .container {
  position: relative;
  z-index: 1;
}
.hero-text { max-width: 800px; }
.hero h1{font-size:clamp(32px,4.2vw,48px);line-height:1.12;color:#fff;margin:16px 0 12px}
.hero p{color:var(--muted);font-size:clamp(15px,1.5vw,18px);max-width:620px;margin-bottom:24px}
.hero-badge{display:inline-flex;align-items:center;gap:10px;background:rgba(212,169,78,.15);border:1px solid rgba(212,169,78,.45);border-radius:50px;padding:9px 20px;color:var(--gold2);font-size:14px;font-weight:600}
.hero-badge a{color:var(--gold2);text-decoration:none}
.hero-cta{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:0;}

/* Статистика в Hero */
.hero-stats{display:flex;gap:clamp(28px,6vw,80px);flex-wrap:wrap;border-top:1px solid rgba(212,169,78,.3);padding-top:20px; margin-top: 30px;}
.stat b{display:block;font-family:var(--fs);font-variant-numeric:tabular-nums;font-size:clamp(24px,3.2vw,36px);color:var(--gold);font-weight:700}
.stat span{color:var(--muted);font-size:14px}
.scroll-hint{position:absolute;bottom:15px;left:50%;transform:translateX(-50%);color:var(--muted);font-size:13px;animation:bounce 2s infinite; z-index:1;}
@keyframes bounce{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,10px)}}

/* Квиз */
.quiz{background:linear-gradient(rgba(13,14,17,.90), rgba(13,14,17,.95)), url('bg_photo_kviz.png') center/cover no-repeat}
.quiz-card{max-width:760px;margin:0 auto;background:var(--card);border:1px solid rgba(212,169,78,.2);border-radius:20px;padding:clamp(24px,4vw,48px);box-shadow:0 20px 60px rgba(0,0,0,.35)}
.quiz-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;color:var(--muted);font-size:14px}
.quiz-progress{height:6px;background:var(--bg);border-radius:6px;margin-bottom:34px;overflow:hidden}
.quiz-progress div{height:100%;background:linear-gradient(90deg,var(--gold),var(--gold2));border-radius:6px;transition:width .4s ease}
.q-title{font-family:var(--ff);font-size:clamp(21px,2.6vw,27px);color:#fff;margin-bottom:8px}
.q-hint{color:var(--muted);font-size:14px;margin-bottom:26px}
.q-opts{display:flex;flex-direction:column;gap:12px}
.q-opt{display:flex;align-items:center;gap:16px;padding:16px 20px;background:var(--bg);border:1.5px solid transparent;border-radius:12px;cursor:pointer;transition:all .2s;width:100%;color:var(--text);font-size:15.5px;font-family:var(--fs);text-align:left}
.q-opt i{color:var(--gold);font-size:20px;width:26px;text-align:center;flex-shrink:0}
.q-opt:hover{border-color:rgba(212,169,78,.5);background:var(--card2)}
.q-opt.sel{border-color:var(--gold);background:rgba(212,169,78,.12)}
.q-opt.sel i{color:var(--gold2)}
.q-error{color:#ff8a8a;font-size:14px;margin-top:16px;display:none}
.q-error.show{display:block;animation:shake .4s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.q-nav{display:flex;justify-content:space-between;gap:12px;margin-top:28px;flex-wrap:wrap}
.q-nav .btn{padding:12px 28px}
.quiz-step{display:none}
.quiz-step.active{display:block;animation:fadeIn .35s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.q-input{width:100%;padding:15px 18px;background:var(--bg);border:1.5px solid rgba(212,169,78,.3);border-radius:12px;color:var(--text);font-size:16px;margin-bottom:6px;outline:none;transition:border .2s;font-family:var(--fs)}
.q-input:focus{border-color:var(--gold)}
.q-input.err{border-color:#ff8a8a}
.q-label{color:var(--muted);font-size:13px;margin:10px 0 6px;display:block}
.consent{display:flex;gap:10px;align-items:flex-start;margin:16px 0 6px;font-size:13.5px;color:var(--muted)}
.consent input{margin-top:4px;accent-color:var(--gold);width:17px;height:17px}
.consent a{color:var(--gold)}
.mess-choice{display:flex;gap:12px;margin:18px 0 4px;flex-wrap:wrap}
.mess-choice .q-opt{flex:1 1 220px;justify-content:center;font-weight:600;padding:15px}
.mess-choice .q-opt.wa.sel{border-color:var(--green);background:rgba(37,211,102,.12)}
.mess-choice .q-opt.wa i{color:var(--green)}
.mess-choice .q-opt.max.sel{border-color:var(--maxc);background:rgba(135,120,255,.12)}
.mess-choice .q-opt.max i{color:var(--maxc)}
.q-privacy{color:var(--muted);font-size:12.5px;text-align:center;margin-top:18px}

/* Сетки */
.g-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.g-card{background:var(--card);border:1px solid rgba(212,169,78,.15);border-radius:var(--radius);overflow:hidden;transition:transform .3s,box-shadow .3s}
.g-card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(0,0,0,.4)}
.g-ph{height:210px;display:flex;align-items:center;justify-content:center;font-size:52px;color:var(--gold);background:linear-gradient(140deg,#2e323b,#20242c 55%,#3a3020);position:relative}
.g-ph::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(0,0,0,.45));pointer-events:none}
.g-body{padding:22px}
.g-body h3{font-size:19px;margin-bottom:8px;color:#fff}
.g-body p{color:var(--muted);font-size:14px}
.g-note{margin-top:36px;text-align:center;background:rgba(212,169,78,.08);border:1px dashed rgba(212,169,78,.4);border-radius:12px;padding:18px 24px;color:var(--muted);font-size:14.5px}
.g-note i{color:var(--gold);margin-right:8px}
.g-note a{color:var(--gold2)}

.cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.cat{background:var(--card);border:1px solid rgba(212,169,78,.15);border-radius:var(--radius);padding:32px 28px;display:flex;flex-direction:column;transition:transform .3s}
.cat:hover{transform:translateY(-6px)}
.cat>i{font-size:38px;color:var(--gold);margin-bottom:18px}
.cat h3{font-size:21px;margin-bottom:12px;color:#fff}
.cat p{color:var(--muted);font-size:14.5px;flex:1}
.cat .price{font-family:var(--ff);font-size:26px;color:var(--gold);margin:18px 0 4px}
.cat .term{color:var(--muted);font-size:13px;margin-bottom:20px}

.cta-strip{background:linear-gradient(135deg,rgba(212,169,78,.16),rgba(212,169,78,.05));border:1px solid rgba(212,169,78,.3);border-radius:20px;padding:clamp(30px,5vw,52px);text-align:center;margin-top:56px}
.cta-strip h3{font-size:clamp(21px,2.6vw,30px);color:#fff;margin-bottom:12px}
.cta-strip p{color:var(--muted);margin-bottom:26px;max-width:560px;margin-left:auto;margin-right:auto}

.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.gcard{background:var(--card);border:1px solid rgba(212,169,78,.15);border-radius:var(--radius);padding:30px 26px;transition:transform .3s}
.gcard:hover{transform:translateY(-5px)}
.gcard>i{font-size:30px;color:var(--gold);margin-bottom:16px;display:block}
.gcard h4{font-family:var(--ff);font-size:18px;color:#fff;margin-bottom:10px}
.gcard p{color:var(--muted);font-size:14px}

.p4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;counter-reset:step}
.pcard{background:var(--card);border:1px solid rgba(212,169,78,.15);border-radius:var(--radius);padding:30px 24px;position:relative}
.pcard::before{counter-increment:step;content:'0' counter(step);font-family:var(--ff);font-size:44px;color:rgba(212,169,78,.35);display:block;line-height:1;margin-bottom:14px}
.pcard h4{font-family:var(--ff);font-size:18px;color:#fff;margin-bottom:10px}
.pcard p{color:var(--muted);font-size:14px}
.pnote{margin-top:34px;text-align:center;background:rgba(37,211,102,.07);border:1px solid rgba(37,211,102,.3);border-radius:12px;padding:18px;color:var(--muted);font-size:14.5px}
.pnote i{color:var(--green);margin-right:8px}

/* Отзывы */
.rev-widget{margin-top:18px;border:1px solid rgba(212,175,55,.25);border-radius:14px;overflow:hidden;background:#141a24}
.rev-widget iframe{display:block;width:100%;height:520px;border:0}
.rev-sum{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px;margin-top:22px;padding:18px 22px;border:1px solid rgba(212,175,55,.3);border-radius:14px;background:linear-gradient(135deg,rgba(212,175,55,.08),rgba(212,175,55,.02))}
.rev-sum b{font-size:34px;color:var(--gold);font-family:Georgia,serif}
.rev-sum .stars i{color:var(--gold);font-size:15px}
.rev-sum a{color:var(--gold);text-decoration:underline;text-underline-offset:3px;font-size:14px}
.rev-sum small{width:100%;color:#8a93a6;font-size:12.5px}

/* FAQ */
details{background:var(--card);border:1px solid rgba(212,169,78,.15);border-radius:12px;margin-bottom:14px;overflow:hidden}
summary{padding:20px 24px;cursor:pointer;font-weight:600;color:#fff;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px}
summary::after{content:'+';color:var(--gold);font-size:22px;transition:transform .3s;flex-shrink:0}
details[open] summary::after{transform:rotate(45deg)}
details div{padding:0 24px 20px;color:var(--muted);font-size:15px}

/* Контакты */
.c-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}
.c-info{display:flex;flex-direction:column;gap:20px}
.c-item{display:flex;gap:16px;align-items:flex-start}
.c-item i{color:var(--gold);font-size:19px;margin-top:4px;width:24px;text-align:center;flex-shrink:0}
.c-item b{color:#fff;display:block;font-size:15.5px}
.c-item span,.c-item a{color:var(--muted);font-size:14.5px;text-decoration:none}
.c-item a:hover{color:var(--gold2)}
.map-wrap{border-radius:var(--radius);overflow:hidden;border:1px solid rgba(212,169,78,.25);min-height:420px}
.map-wrap iframe{width:100%;height:460px;border:0;display:block}

/* Подвал */
footer{background:#101216;border-top:1px solid rgba(212,169,78,.2);padding:44px 0;text-align:center;color:var(--muted);font-size:13.5px}
footer .flinks{margin:14px 0}
footer .flinks a{color:var(--gold2);text-decoration:none;margin:0 10px}
.disc{max-width:860px;margin:0 auto;color:#7a7d82;font-size:12px}

/* Cookie */
.cookie{position:fixed;bottom:0;left:0;right:0;background:rgba(20,22,26,.97);border-top:1px solid rgba(212,169,78,.35);padding:16px 24px;z-index:1100;display:flex;gap:16px;align-items:center;justify-content:center;flex-wrap:wrap;transform:translateY(110%);transition:transform .4s}
.cookie.show{transform:translateY(0)}
.cookie p{color:var(--muted);font-size:13.5px;max-width:640px}
.cookie p a{color:var(--gold2)}
.cookie button{padding:10px 20px;border-radius:8px;border:none;cursor:pointer;font-weight:600;font-size:13.5px}
.cookie .c-all{background:var(--gold);color:#1a1a1a}
.cookie .c-min{background:transparent;color:var(--gold);border:1px solid var(--gold)}

/* Модалки */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:1200;display:none;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto}
.modal.open{display:flex}
.modal-box{background:var(--bg2);border:1px solid rgba(212,169,78,.3);border-radius:16px;max-width:760px;width:100%;padding:36px;position:relative;animation:fadeIn .3s}
.modal-box h2{color:#fff;margin-bottom:18px;font-size:24px}
.modal-box h3{color:var(--gold2);margin:20px 0 8px;font-size:17px}
.modal-box p,.modal-box li{color:var(--muted);font-size:14.5px}
.modal-close{position:absolute;top:14px;right:16px;background:none;border:none;color:var(--muted);font-size:22px;cursor:pointer}

/* FAB */
.fab{position:fixed;right:22px;bottom:22px;z-index:1050;display:flex;flex-direction:column;align-items:flex-end;gap:12px}
.fab-main{width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,var(--gold),#b8860b);color:#1a1a1a;border:none;font-size:23px;cursor:pointer;box-shadow:0 8px 28px rgba(212,169,78,.45);transition:transform .3s}
.fab-main:hover{transform:scale(1.08)}
.fab-items{display:flex;flex-direction:column;gap:10px}
.fab-item{position:relative;width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;text-decoration:none;opacity:0;transform:translateY(20px) scale(.6);pointer-events:none;transition:all .35s cubic-bezier(.34,1.56,.64,1)}
.fab.open .fab-item{opacity:1;transform:translateY(0) scale(1);pointer-events:auto}
.fab.open .fab-item:nth-child(1){transition-delay:.05s}
.fab.open .fab-item:nth-child(2){transition-delay:.13s}
.fab.open .fab-item:nth-child(3){transition-delay:.21s}
.fab-item.phone{background:#2f81f7;color:#fff}
.fab-item.wa{background:var(--green);color:#fff}
.fab-item.max{background:var(--maxc);color:#fff}
.fab-item:hover{transform:scale(1.12)}
.fab-item .tip{position:absolute;right:58px;background:var(--card2);color:var(--text);font-size:12px;padding:5px 10px;border-radius:8px;white-space:nowrap;opacity:0;transition:opacity .2s;pointer-events:none}
.fab-item:hover .tip{opacity:1}
.fab.open .fab-main i{transform:rotate(135deg)}
.fab-main i{transition:transform .3s}

/* Уведомление о копировании */
.copy-toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--card2);color:var(--text);padding:12px 24px;border-radius:12px;border:1px solid var(--gold);font-size:14px;z-index:1300;opacity:0;pointer-events:none;transition:opacity .3s,transform .3s;box-shadow:0 8px 24px rgba(0,0,0,.5)}
.copy-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* АДАПТИВ */
@media(max-width:1400px){.container{max-width:1140px}}
@media(max-width:1100px){
  nav.desktop{display:none}
  .burger{display:block}
  .g4,.p4{grid-template-columns:repeat(2,1fr)}
  .g-grid,.cat-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:900px){
  .c-grid{grid-template-columns:1fr}
  .section{padding:64px 0}
  .hero{padding: 100px 0 40px;}
}
@media(max-width:640px){
  .g-grid,.cat-grid,.g4,.p4{grid-template-columns:1fr}
  .hero-cta .btn{width:100%}
  .q-nav .btn{flex:1}
  .quiz-card{padding:22px 18px}
  .hero-stats{gap:22px; margin-top: 20px;}
  .fab{right:16px;bottom:16px}
}
@media(max-width:380px){
  .logo{font-size:16px}
  .container{padding:0 16px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
<!-- JSON-LD для локального бизнеса -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
